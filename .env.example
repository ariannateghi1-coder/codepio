# Core (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academy_support
SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRUSTED_PROXY_HOPS=0

# Official YouTube API and OAuth
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Operations
MAINTENANCE_SECRET=
LOG_LEVEL=info

# Disposable PostgreSQL integration-test database
TEST_DATABASE_URL=

# Optional: PostgreSQL rate limiting and polling are fallbacks
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ABLY_API_KEY=

# Optional free standards-based Web Push
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
