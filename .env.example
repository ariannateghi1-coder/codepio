# Core (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academy_support
SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRUSTED_PROXY_HOPS=0

# Official YouTube API and OAuth
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound email (SMTP). All four of HOST/USER/PASSWORD/FROM together, or none:
# a half-configured mailer would make password reset fail SILENTLY, so the app
# refuses to boot in that state instead. SMTP_FROM must be an address the
# provider has authorised for the account (in Brevo: a validated sender), or
# every message is rejected at send time while the app still looks healthy.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# Operations
MAINTENANCE_SECRET=
LOG_LEVEL=info

# Disposable PostgreSQL integration-test database
TEST_DATABASE_URL=

# Optional: PostgreSQL rate limiting and polling are fallbacks
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ABLY_API_KEY=

# Optional free standards-based Web Push
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
