// Academy Support — Support Exchange / Social Discovery Platform
//
// Core product loop this schema is built around:
//   CREATE CONTENT → CREATE CAMPAIGN → ENTER EXPLORE → DISCOVERY →
//   START SUPPORT → WATCH → SUBSCRIBE → LIKE → (COMMENT) →
//   SERVER VERIFICATION → ANTI-ABUSE → COMPLETED →
//   CREDITS + XP + REPUTATION → EXPOSURE → LOOP
//
// Four separate economies, deliberately NOT merged into one number:
//   credits    — spendable/earnable economy      (source of truth: CreditLedger)
//   points     — XP / progression, drives level   (source of truth: XpLedger)
//   reputation — trust & quality, drives exposure (source of truth: ReputationEvent)
//   trustScore — internal anti-abuse score, never shown raw to the user
//
// Every mutation of the first three MUST go through a ledger entry so that a
// reversal is an accounting operation, not a raw `points -= x`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  BANNED
}

enum RankTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  ELITE
}

enum VideoStatus {
  ACTIVE
  HIDDEN
  REMOVED
}

enum SupportStatus {
  ACTIVE
  REVERSED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// What a campaign asks a supporter to actually do.
enum TaskType {
  WATCH_VIDEO
  SUBSCRIBE_CHANNEL
  LIKE_VIDEO
  COMMENT_VIDEO
}

/// Lifecycle of one supporter's attempt at one campaign.
enum SupportSessionState {
  STARTED
  VIDEO_OPENED
  WATCHING
  WATCH_THRESHOLD_REACHED
  VERIFYING
  COMPLETED
  FAILED
  EXPIRED
  ABANDONED
}

enum SupportTaskState {
  PENDING
  IN_PROGRESS
  SATISFIED
  FAILED
  SKIPPED
}

/// How strongly a task's completion is actually proven. Surfaced verbatim in
/// the UI — the product must never label something "Verified by YouTube" when
/// it was only observed in the browser.
enum VerificationMethod {
  YOUTUBE_API
  PLATFORM_OBSERVED
  SELF_REPORTED
  UNVERIFIED
}

enum VerificationResult {
  PASSED
  FAILED
  INCONCLUSIVE
  PENDING
}

/// Whether the reward for a session has been paid, held for review, or clawed back.
enum RewardState {
  NONE
  PENDING_REVIEW
  CONFIRMED
  DENIED
  REVERSED
}

enum CreditEntryType {
  SUPPORT_COMPLETED
  SUPPORT_RECEIVED
  MUTUAL_BONUS
  CAMPAIGN_BONUS
  REFERRAL
  BADGE_REWARD
  ADMIN_ADJUSTMENT
  CAMPAIGN_BUDGET_SPEND
  REVERSAL
  PENALTY
  /// One-time signup grant: the only place credits enter the system.
  /// Added by migration 20260814000000, so it is LAST in Postgres enum order.
  /// SUPPORT_RECEIVED / MUTUAL_BONUS / CAMPAIGN_BONUS / REFERRAL / BADGE_REWARD
  /// are retained for historical rows only; nothing writes them any more, because
  /// they minted credits with no paying counterparty.
  SIGNUP_GRANT
}

enum XpEntryType {
  SUPPORT_COMPLETED
  SUPPORT_RECEIVED
  MUTUAL_BONUS
  STREAK
  BADGE_REWARD
  REFERRAL
  ADMIN_ADJUSTMENT
  REVERSAL
  PENALTY
}

enum ReputationEventType {
  SUPPORT_VERIFIED
  SUPPORT_PARTIAL
  SUPPORT_REVERSED
  ABUSE_SIGNAL
  REPORT_UPHELD
  REPORT_DISMISSED
  CAMPAIGN_COMPLETED
  ACCOUNT_AGE
  CHANNEL_VERIFIED
  ADMIN_ADJUSTMENT
}

enum AbuseSignalType {
  IMPOSSIBLE_WATCH_SPEED
  SEEK_JUMP_ABUSE
  HEARTBEAT_ANOMALY
  HEARTBEAT_REPLAY
  BACKGROUND_WATCH
  SUPPORT_VELOCITY
  RECIPROCAL_LOOP
  FARMING_RING
  PAIR_FARMING
  SELF_SUPPORT_ATTEMPT
  REFERRAL_ABUSE
  DUPLICATE_DEVICE
  SUBSCRIPTION_CHURN
  CLIENT_TAMPERING
  ACCOUNT_TOO_NEW
}

/// Lifecycle of one supporter's obligation to keep a subscription they were paid
/// for. Deliberately separate from SupportStatus: that enum's only non-ACTIVE
/// value is REVERSED, which claws back credits and XP — the opposite of what is
/// wanted here, where the payment stands and only future participation is gated.
///
/// RESTORED rather than a return to ACTIVE, so "never broke it" and "broke it and
/// fixed it" stay distinguishable: both grant access, but only one is worth
/// weighing when judging a pattern of churn.
enum ComplianceStatus {
  ACTIVE
  VIOLATED
  RESTORED
}

/// Lifecycle of a YouTube OAuth grant. An explicit state is what stops the app
/// from retrying a permanently dead grant forever, and lets the UI say precisely
/// what the user must do.
enum YoutubeConnectionState {
  /// Usable now, or refreshable with the stored refresh token.
  CONNECTED
  /// Access token expired and no refresh token is available.
  EXPIRED
  /// The grant was revoked or refused (invalid_grant), or scopes are missing.
  /// Only the user can fix this, by reconnecting.
  REAUTH_REQUIRED
  /// The user disconnected deliberately.
  DISCONNECTED
  /// Repeated non-authorization failures (provider outage, quota). Retryable.
  ERROR
}

enum LeaderboardPeriod {
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum LeaderboardMode {
  TOP_SUPPORTERS
  TOP_CREATORS
  HIGHEST_REPUTATION
  RISING
}

enum NotificationType {
  SUPPORT_RECEIVED
  SUPPORT_BACK_AVAILABLE
  SUPPORT_MUTUAL
  SUPPORT_VERIFIED
  SUPPORT_REVERSED
  REWARD_PENDING
  NEW_VIDEO
  CAMPAIGN_UPDATE
  ANNOUNCEMENT
  MENTION
  SECURITY
  SYSTEM
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ActivityType {
  SUPPORT_CREATED
  SUPPORT_RECEIVED
  MUTUAL_SUPPORT
  SUPPORT_REVERSED
  VIDEO_ADDED
  CAMPAIGN_CREATED
  BADGE_EARNED
  LEVEL_UP
  RANK_UP
  CAMPAIGN_JOINED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  VIDEO
  SUPPORT
  CAMPAIGN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SUPPORT
  SUPPORT_REVERSAL
  NOTIFICATION
  ADMIN_ACTION
  SECURITY
  LEDGER_ADJUSTMENT
}

model User {
  id       String @id @default(cuid())
  username String @unique
  email    String @unique

  passwordHash String
  name         String
  avatarUrl    String?
  bio          String?
  country      String?
  language     String  @default("fa")

  role   Role       @default(USER)
  status UserStatus @default(PENDING)

  emailVerified   Boolean @default(false)
  youtubeVerified Boolean @default(false)

  /// XP total. Invariant: equals SUM(XpLedger.amount) for this user.
  points     Int      @default(0)
  level      Int      @default(1)
  /// Spendable credits. Invariant: equals SUM(CreditLedger.amount) for this user.
  credits    Int      @default(0)
  /// Trust/quality score (0..1000, seeded at 100). Drives Explore exposure.
  reputation Int      @default(100)
  /// Internal anti-abuse score (0..100). Never rendered raw in the UI.
  trustScore Int      @default(50)
  rankTier   RankTier @default(BRONZE)

  /// Rolling completion quality, cached from SupportSession outcomes so Explore
  /// ranking doesn't have to aggregate sessions on every request.
  supportsCompleted Int       @default(0)
  supportsAbandoned Int       @default(0)
  currentStreakDays Int       @default(0)
  longestStreakDays Int       @default(0)
  lastStreakDay     DateTime?

  referralCode String    @unique
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions               Session[]
  youtubeConnection      YoutubeConnection?
  youtubeAccount         YoutubeAccount?
  videos                 Video[]
  campaigns              Campaign[]               @relation("campaignCreator")
  supportsGiven          Support[]                @relation("supportsGiven")
  supportsReceived       Support[]                @relation("supportsReceived")
  supportSessions        SupportSession[]         @relation("sessionSupporter")
  receivedSessions       SupportSession[]         @relation("sessionCreator")
  creditEntries          CreditLedger[]
  xpEntries              XpLedger[]
  reputationEvents       ReputationEvent[]
  abuseSignals           AbuseSignal[]
  notifications          Notification[]           @relation("userNotifications")
  actorNotifications     Notification[]           @relation("actorNotifications")
  activities             Activity[]               @relation("userActivities")
  actorActivities        Activity[]               @relation("actorActivities")
  badges                 UserBadge[]
  referralsMade          Referral[]               @relation("referrer")
  referredBy             Referral[]               @relation("referred")
  reportsMade            Report[]                 @relation("reportsMade")
  reportsResolved        Report[]                 @relation("reportsResolved")
  pushSubscriptions      PushSubscription[]
  auditLogs              AuditLog[]
  subscriptionCompliance SubscriptionCompliance[]
  pairsAsSupporter       SupportPair[]            @relation("pairSupporter")
  pairsAsReceiver        SupportPair[]            @relation("pairReceiver")
  leaderboardRows        LeaderboardSnapshot[]
  dailyRollups           UserDailyRollup[]

  @@index([points(sort: Desc)])
  @@index([credits(sort: Desc)])
  @@index([reputation(sort: Desc)])
  @@index([status])
  @@index([status, createdAt])
  @@index([role])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  csrfTokenHash String
  userAgent     String?
  ipHash        String?
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// Single-use password reset grant. Only the hash of the emailed token is
/// stored, so a database leak cannot be replayed against the reset endpoint.
/// Keyed by email rather than userId: the request is accepted before the
/// account is resolved, so enumeration cannot be inferred from a 404.
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  /// Set the moment the token is redeemed; a non-NULL value must be rejected
  /// even while the token is still inside its expiry window.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// Single-use email verification grant, stored hashed for the same reason as
/// PasswordResetToken. `email` is captured alongside `userId` so a token issued
/// for an address stays bound to it if the account's email later changes.
///
/// `userId` is intentionally a plain column with no relation: the underlying
/// table carries no foreign key, so declaring one here would report as schema
/// drift against the migration history.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Channel record shown on the profile. `verificationMethod` is what the UI
/// must render — an unverified, hand-typed channel URL is never labelled as
/// verified ownership.
model YoutubeConnection {
  id                 String             @id @default(cuid())
  userId             String             @unique
  channelId          String
  channelTitle       String
  channelUrl         String
  thumbnailUrl       String?
  subscriberCount    Int?
  verified           Boolean            @default(false)
  verificationMethod VerificationMethod @default(SELF_REPORTED)
  verifiedAt         DateTime?
  syncedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

/// Google/YouTube OAuth grant. Tokens are stored encrypted at rest (AES-256-GCM,
/// see src/lib/crypto.ts) and are never sent to the client or written to logs.
model YoutubeAccount {
  id                 String                 @id @default(cuid())
  userId             String                 @unique
  googleSub          String                 @unique
  /// The Google account this grant belongs to.
  ///
  /// Kept so the UI can name the identity being inspected. When someone is signed
  /// into several Google accounts, a genuine subscribe or like lands on an account
  /// this grant cannot read, and "not verified" is indistinguishable from a bug
  /// unless we can say WHICH account we checked.
  googleEmail        String?
  channelId          String?
  scope              String
  accessTokenCipher  String
  refreshTokenCipher String?
  accessTokenExpires DateTime?
  lastRefreshedAt    DateTime?
  revokedAt          DateTime?
  /// Explicit lifecycle state. Without this the app could only retry blindly on
  /// every failure; now an invalid_grant moves the connection to REAUTH_REQUIRED
  /// once and the UI asks the user to reconnect instead of looping.
  state              YoutubeConnectionState @default(CONNECTED)
  /// Consecutive refresh failures. Used to stop retrying a dead grant.
  failureCount       Int                    @default(0)
  lastErrorCode      String?
  lastErrorAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state])
}

model Video {
  id               String           @id @default(cuid())
  userId           String
  youtubeVideoId   String
  youtubeUrl       String
  title            String
  description      String?
  thumbnailUrl     String?
  durationSec      Int?
  /// The channel that actually OWNS this video on YouTube, captured from
  /// videos.list when the video is registered or re-synced.
  ///
  /// This — not the uploader's linked account — is the channel a supporter is
  /// asked to subscribe to and the one the subscribe check runs against. Video
  /// ownership is public, so the target stays knowable even for a creator who
  /// never connected OAuth; reading the target from YoutubeConnection instead
  /// left those campaigns with no target at all, and an honest supporter was told
  /// they had not subscribed.
  channelId        String?
  channelTitle     String?
  /// YouTube's "Made for Kids" flag, captured with the rest of the metadata.
  ///
  /// On this content YouTube switches personalisation features off: comments are
  /// hard disabled, and a like is not reliably reflected in the viewer's own
  /// "Liked videos" list — the only surface a read-only grant can read. The like
  /// task is therefore UNVERIFIABLE here whatever scope we hold, so the product
  /// says so up front instead of telling supporters they did not like a video
  /// they really liked.
  madeForKids      Boolean?
  metadataSyncedAt DateTime?
  status           VideoStatus      @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  supports         Support[]
  campaigns        Campaign[]
  sessions         SupportSession[]

  @@unique([userId, youtubeVideoId])
  @@index([youtubeVideoId])
  @@index([userId, status])
  @@index([channelId])
  @@index([status, createdAt(sort: Desc)])
}

/// A creator's request for support on one specific video.
model Campaign {
  id          String  @id @default(cuid())
  /// Null for platform-wide/legacy campaigns not owned by a creator.
  creatorId   String?
  videoId     String?
  title       String
  description String?

  startAt DateTime
  endAt   DateTime
  status  CampaignStatus @default(DRAFT)

  /// Reward economy. Budget is decremented atomically per confirmed reward so
  /// concurrent completions can never drive it negative.
  rewardCredits     Int      @default(10)
  rewardXp          Int      @default(25)
  budgetCredits     Int      @default(0)
  spentCredits      Int      @default(0)
  /// Denormalized completed-support counters used by atomic settlement and Explore.
  completedSupports Int      @default(0)
  dailySupports     Int      @default(0)
  dailyCounterDay   DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date

  maxTotalSupports     Int?
  maxSupportsPerUser   Int?
  dailyLimit           Int?
  /// Minimum account age (hours) a supporter needs — cheap anti-throwaway gate.
  minAccountAgeHours   Int  @default(0)
  /// Creator-set exposure priority, clamped server-side.
  priority             Int  @default(0)
  /// LEGACY. The watch requirement is now the platform constant
  /// WATCH_RULES.defaultRequiredPercent (99%), applied uniformly, and requiredSec
  /// is derived server-side from the duration YouTube reported. The column is kept
  /// so historical campaigns still show the percentage they ran under; nothing
  /// reads it to decide a current requirement.
  requiredWatchPercent Int  @default(99)

  /// The creator declares this campaign as kids content, waiving API verification
  /// of subscribe and like.
  ///
  /// On videos and channels flagged "Made for Kids" YouTube switches
  /// personalisation off: comments are hard disabled and the like never reaches
  /// the viewer's own "Liked videos" playlist, which is the only like surface a
  /// read-only grant can read. Creators report the same about subscriptions to
  /// such channels; we could not confirm that from the API either way, and that
  /// uncertainty is precisely why this is a DECLARATION rather than a detection.
  ///
  /// When set, subscribe and like are recorded as WAIVED — never FAILED. Demanding
  /// that the creator un-flag their video was the wrong fix: it asks them to break
  /// their own YouTube compliance to satisfy our checker.
  ///
  /// The trade is stated in the UI and falls on the creator alone: they pay the
  /// same budget for supports whose subscribe and like nobody can prove. It cannot
  /// be used to cheat supporters, only to buy weaker evidence.
  kidsContent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator  User?            @relation("campaignCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  video    Video?           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tasks    CampaignTask[]
  supports Support[]
  sessions SupportSession[]

  @@index([status, startAt, endAt])
  @@index([creatorId, status])
  @@index([status, priority(sort: Desc), createdAt(sort: Desc)])
}

model CampaignTask {
  id            String        @id @default(cuid())
  campaignId    String
  type          TaskType
  required      Boolean       @default(true)
  /// Task-specific config, e.g. { "watchPercent": 90 } or { "minLength": 15 }.
  config        Json?
  rewardCredits Int           @default(0)
  rewardXp      Int           @default(0)
  timeoutSec    Int           @default(3600)
  sortOrder     Int           @default(0)
  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  supportTasks  SupportTask[]

  @@unique([campaignId, type])
  @@index([campaignId, sortOrder])
}

/// One supporter's verified attempt at one campaign. This — not `Support` — is
/// where the anti-abuse and verification state lives; a `Support` row is only
/// created once a session actually completes.
model SupportSession {
  id          String              @id @default(cuid())
  campaignId  String
  supporterId String
  creatorId   String
  videoId     String?
  state       SupportSessionState @default(STARTED)
  rewardState RewardState         @default(NONE)

  /// 0..100 anti-abuse risk for this specific session.
  riskScore     Int     @default(0)
  riskReasons   Json?
  clientNonce   String?
  ipHash        String?
  userAgentHash String?

  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  completedAt DateTime?
  failedAt    DateTime?
  failureCode String?

  supportId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign      Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  supporter     User                  @relation("sessionSupporter", fields: [supporterId], references: [id], onDelete: Cascade)
  creator       User                  @relation("sessionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  video         Video?                @relation(fields: [videoId], references: [id], onDelete: SetNull)
  support       Support?              @relation(fields: [supportId], references: [id], onDelete: SetNull)
  tasks         SupportTask[]
  watchSession  WatchSession?
  verifications SupportVerification[]
  creditEntries CreditLedger[]
  xpEntries     XpLedger[]
  abuseSignals  AbuseSignal[]

  @@index([supporterId, state])
  @@index([campaignId, state])
  @@index([creatorId, createdAt(sort: Desc)])
  @@index([state, expiresAt])
  /// Retention: finds terminal sessions old enough for their temporary execution
  /// data (WatchSession, SupportVerification) to be purged.
  @@index([state, updatedAt])
}

model SupportTask {
  id             String             @id @default(cuid())
  sessionId      String
  campaignTaskId String?
  type           TaskType
  required       Boolean            @default(true)
  state          SupportTaskState   @default(PENDING)
  method         VerificationMethod @default(UNVERIFIED)
  satisfiedAt    DateTime?
  attempts       Int                @default(0)
  /// Non-sensitive evidence only (e.g. watched seconds, API response codes).
  evidence       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  session      SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  campaignTask CampaignTask?  @relation(fields: [campaignTaskId], references: [id], onDelete: SetNull)

  @@unique([sessionId, type])
  @@index([sessionId, state])
}

/// Server-authoritative watch tracking. The client only reports player events;
/// the server merges them into `segments` and derives `accumulatedSec`, so a
/// seek to 90% cannot be counted as having watched 90%.
model WatchSession {
  id              String         @id @default(cuid())
  sessionId       String         @unique
  videoId         String?
  durationSec     Int
  requiredSec     Int
  /// TIMER ANCHOR — the instant the supporter opened the video on YouTube.
  ///
  /// The watch flow sends the supporter to youtube.com instead of embedding a
  /// player, so there is no playback to observe and completion is decided purely
  /// by elapsed server time since this instant. Written ONCE with a conditional
  /// update (WHERE "openedAt" IS NULL), so a refresh, a double click or a
  /// replayed request can neither restart the clock nor run two timers for one
  /// session. Null means the video was never opened, which can never be
  /// satisfied — that is what stops a client from skipping to completion.
  openedAt        DateTime?
  accumulatedSec  Int            @default(0)
  /// LEGACY (segment-tracking era). No longer written: the current flow opens
  /// the video on YouTube, so there are no player events to segment. Kept so the
  /// rows already recorded stay readable and so an in-page player could return.
  segments        Json           @default("[]")
  /// LEGACY, as above: these five columns were fed by the in-page player's
  /// heartbeats. They are structurally 0 for sessions created by the timer flow,
  /// which is why the risk engine treats the playback signals as ABSENT rather
  /// than as zero — see assessSessionEvidence.
  playerState     String         @default("IDLE")
  heartbeats      Int            @default(0)
  maxRate         Float          @default(1)
  seekCount       Int            @default(0)
  /// Monotonic client heartbeat counter. The server rejects a sequence it has
  /// already seen (replay) or one lower than the last accepted (out-of-order),
  /// so a reordered network delivery cannot corrupt the watched segments.
  lastSequence    Int            @default(0)
  /// Position reported by the last ACCEPTED heartbeat. This is the credit cursor;
  /// deriving it from the segment list alone lost information after a rewind.
  lastPosition    Int            @default(0)
  /// Count of heartbeats refused as stale/replayed — an abuse signal input.
  rejectedBeats   Int            @default(0)
  /// Seconds the player reported as hidden/backgrounded, reported by the client
  /// via the Page Visibility API. Advisory only: a hostile client can lie, so it
  /// lowers trust but never by itself grants or denies a reward.
  hiddenSec       Int            @default(0)
  startedAt       DateTime       @default(now())
  lastHeartbeatAt DateTime       @default(now())
  completedAt     DateTime?
  session         SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([lastHeartbeatAt])
}

model SupportVerification {
  id        String             @id @default(cuid())
  sessionId String
  taskType  TaskType
  method    VerificationMethod
  result    VerificationResult
  /// Provider status codes / observed counters. No tokens, no PII.
  detail    Json?
  createdAt DateTime           @default(now())
  session   SupportSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, taskType])
  /// Retention: purged once the owning session is terminal. Indexed on age so the
  /// scan is a range read rather than a full table scan.
  @@index([createdAt])
}

/// Append-only credit accounting. `idempotencyKey` makes every award/reversal
/// safe to retry: a duplicate write hits the unique constraint instead of
/// paying twice.
model CreditLedger {
  id             String          @id @default(cuid())
  userId         String
  type           CreditEntryType
  amount         Int
  balanceAfter   Int
  sessionId      String?
  campaignId     String?
  supportId      String?
  reversalOfId   String?         @unique
  idempotencyKey String          @unique
  reason         String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    SupportSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  reversalOf CreditLedger?   @relation("creditReversal", fields: [reversalOfId], references: [id])
  reversedBy CreditLedger?   @relation("creditReversal")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type, createdAt])
  @@index([createdAt])
}

/// Permanent, per-user, per-UTC-day aggregates. NEVER subject to retention.
///
/// This table is what makes retention on the detail tables safe. Two consumers
/// read windows LONGER than the detail tables are kept:
///
///   `xp`            XpLedger is kept 7 days, but the leaderboard offers WEEKLY,
///                   MONTHLY (30d) and ALL_TIME, and the dashboard compares this
///                   week against the previous one (8–14 days old). Summing the
///                   detail table would have made MONTHLY mean "last 7 days" and
///                   ALL_TIME mean "since the last cleanup".
///
///   `abuseSeverity` AbuseSignal is kept 7 days, but recalculateTrustScore() sums
///                   signal severity over 30 days. Reading the detail table would
///                   have let a flagged account's trust score silently recover a
///                   week after the flags, which is precisely what the anti-abuse
///                   layer is supposed to prevent.
///
/// One row per user per day keeps this bounded: 1,000 active users is ~1,000
/// rows/day, ~365k rows/year — small enough to keep forever, unlike the ~1M
/// XpLedger rows a single month of supports produces.
///
/// Both columns are NET signed sums for the day, so an XP reversal on the same day
/// cancels out exactly as it does in the balance.
model UserDailyRollup {
  userId        String
  /// UTC calendar day (midnight). Date, not DateTime, so equality is unambiguous.
  day           DateTime @db.Date
  xp            Int      @default(0)
  /// Sum of AbuseSignal.severity recorded for this user on this day.
  abuseSeverity Int      @default(0)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  /// Leaderboard reads "everyone, since <day>", which needs day first.
  @@index([day])
}

/// DETAIL/AUDIT TRAIL ONLY — subject to retention (see src/lib/services/retention.ts).
///
/// Nothing may compute a balance or a ranking from this table. The permanent
/// aggregates are User.points (current total) and XpDailyRollup (per-day history).
/// Before retention existed, computeLeaderboard() and the dashboard trend summed
/// this table directly, which meant deleting old rows would silently shrink the
/// MONTHLY leaderboard and turn ALL_TIME into "since the last cleanup".
model XpLedger {
  id             String      @id @default(cuid())
  userId         String
  type           XpEntryType
  amount         Int
  balanceAfter   Int
  sessionId      String?
  supportId      String?
  reversalOfId   String?     @unique
  idempotencyKey String      @unique
  reason         String?
  metadata       Json?
  createdAt      DateTime    @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    SupportSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  reversalOf XpLedger?       @relation("xpReversal", fields: [reversalOfId], references: [id])
  reversedBy XpLedger?       @relation("xpReversal")

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

model ReputationEvent {
  id             String              @id @default(cuid())
  userId         String
  type           ReputationEventType
  delta          Int
  valueAfter     Int
  sessionId      String?
  idempotencyKey String              @unique
  reason         String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model AbuseSignal {
  id         String          @id @default(cuid())
  userId     String
  sessionId  String?
  type       AbuseSignalType
  /// 1 (weak hint) .. 10 (near-certain abuse).
  severity   Int             @default(1)
  metadata   Json?
  reviewedAt DateTime?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    SupportSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt])
  /// Retention scans by age across all users and types.
  @@index([createdAt])
}

/// Per-pair counters backing diminishing returns and reciprocal-loop detection
/// (A→B→A→B farming).
model SupportPair {
  supporterId     String
  receiverId      String
  supportCount    Int      @default(0)
  reciprocalCount Int      @default(0)
  lastSupportAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  supporter       User     @relation("pairSupporter", fields: [supporterId], references: [id], onDelete: Cascade)
  receiver        User     @relation("pairReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@id([supporterId, receiverId])
  @@index([receiverId])
  @@index([lastSupportAt])
}

/// Completed support. Kept as the historical/reporting record; the reward math
/// lives in the ledgers, the verification detail in SupportSession.
model Support {
  id             String        @id @default(cuid())
  supporterId    String
  receiverId     String
  campaignId     String
  videoId        String?
  status         SupportStatus @default(ACTIVE)
  /// Copy of the reward actually paid, so history stays readable even if the
  /// campaign's reward config changes later.
  creditsAwarded Int           @default(0)
  xpAwarded      Int           @default(0)
  mutual         Boolean       @default(false)

  /// SELF-CONTAINED OUTCOME RECORD.
  ///
  /// These three fields exist so that "was this support legitimate, and why was it
  /// paid?" can be answered from the Support row alone, after the temporary
  /// execution data has been purged. Previously the only evidence lived in
  /// WatchSession and SupportVerification, which meant those tables could never
  /// actually be deleted without losing the ability to audit a past support.
  ///
  /// Written once, at settlement, inside the same transaction as the payout.
  /// watchedSec  — seconds credited by the server at completion
  /// requiredSec — what the campaign demanded at that time
  /// riskScore   — the anti-abuse score the decision was made on
  /// verification — compact per-task result: [{ type, method, result }]
  watchedSec       Int       @default(0)
  requiredWatchSec Int       @default(0)
  riskScore        Int       @default(0)
  verification     Json?
  reversedAt       DateTime?
  reversedById     String?
  reversalReason   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  supporter User            @relation("supportsGiven", fields: [supporterId], references: [id], onDelete: Cascade)
  receiver  User            @relation("supportsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  campaign  Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  video     Video?          @relation(fields: [videoId], references: [id], onDelete: SetNull)
  session   SupportSession?

  compliance SubscriptionCompliance?

  @@unique([supporterId, receiverId, campaignId])
  @@index([receiverId, status, createdAt(sort: Desc)])
  @@index([supporterId, status, createdAt(sort: Desc)])
  @@index([campaignId, status])
  @@index([status, createdAt])
}

/// Precomputed leaderboard rows so period ranking is a real ledger-derived
/// figure instead of an activity proxy, and reads stay cheap.
/// Ongoing subscription obligation created by a paid support.
///
/// WHY THIS IS ITS OWN TABLE
/// A supporter paid for subscribing who then unsubscribes has taken the reward
/// without leaving the value behind. Detecting that means re-asking YouTube long
/// after the session is gone, so the obligation has to outlive the session:
/// SupportSession's children are purged two days after settlement (see
/// services/retention.ts), and SupportVerification only records what was true at
/// settlement time.
///
/// WHAT IS DELIBERATELY NOT HERE
/// No credits, no XP, no reward state. Compliance never edits the accounting
/// record — a violation gates future participation and nothing else, so the
/// ledgers, Support.creditsAwarded and the cached balances on User are untouched
/// by anything in this model's lifecycle.
///
/// QUOTA DISCIPLINE
/// `lastSubscriptionCheckAt` is the cache timestamp, and it is why a page load
/// costs zero YouTube quota: a fresh value is reused until it ages past the TTL,
/// and only a sensitive operation (starting a support, resolving a held reward, an
/// explicit recheck) may force a live call. `nextCheckAfter` adds exponential
/// backoff on top, so a provider outage cannot become a retry storm against a
/// quota that is already failing.
model SubscriptionCompliance {
  id              String @id @default(cuid())
  userId          String
  /// The paid support this obligation came from. Unique — one support creates at
  /// most one obligation, which is also what makes settlement replay-safe.
  supportId       String @unique
  /// Creator channel that had to be subscribed. Copied at creation so the check
  /// still works if the creator later links a different channel: the obligation is
  /// to the channel that was actually supported.
  targetChannelId String

  /// False when the campaign carried no SUBSCRIBE_CHANNEL task. Such rows are
  /// never checked and never block anything; they exist so "no obligation" is a
  /// recorded fact rather than a missing row.
  subscriptionRequired    Boolean   @default(true)
  /// True once YouTube itself confirmed the subscription at least once. A row
  /// without this was never API-verified, so it must never be read as a violation.
  subscriptionVerified    Boolean   @default(false)
  /// Last definitive answer. Written only from a real API verdict — never from a
  /// timeout, a quota rejection or a dead grant.
  lastKnownSubscribed     Boolean   @default(false)
  /// Cache timestamp driving the TTL. Null means never checked.
  lastSubscriptionCheckAt DateTime?

  status ComplianceStatus @default(ACTIVE)

  /// Consecutive failed checks (timeout / 5xx / 429 / quota). Drives the backoff
  /// in `nextCheckAfter`; any definitive answer resets it to zero.
  checkFailureCount Int       @default(0)
  /// Earliest instant a background sweep may check this row again. Set only by
  /// failures, and ignored by an explicit user-initiated recheck — an outage must
  /// never leave a user unable to prove they fixed things.
  nextCheckAfter    DateTime?

  violationDetectedAt DateTime?
  restoredAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  support Support @relation(fields: [supportId], references: [id], onDelete: Cascade)

  /// The gate's hot path: "is this user currently in violation?"
  @@index([userId, status])
  /// The sweep's selection: stale rows of a given status, oldest first.
  @@index([status, lastSubscriptionCheckAt])
  @@index([nextCheckAfter])
  @@index([targetChannelId])
}

model LeaderboardSnapshot {
  id          String            @id @default(cuid())
  period      LeaderboardPeriod
  mode        LeaderboardMode
  periodStart DateTime
  userId      String
  rank        Int
  score       Int
  credits     Int               @default(0)
  xp          Int               @default(0)
  supports    Int               @default(0)
  reputation  Int               @default(0)
  computedAt  DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([period, mode, periodStart, userId])
  @@index([period, mode, periodStart, rank])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  actorId        String?
  type           NotificationType
  title          String
  message        String
  metadata       Json?
  read           Boolean          @default(false)
  deliveryStatus DeliveryStatus   @default(PENDING)
  /// Set for notifications that must never be duplicated (badge awards,
  /// reward confirmations); NULL for ordinary ones.
  dedupeKey      String?          @unique
  createdAt      DateTime         @default(now())
  user           User             @relation("userNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?            @relation("actorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  /// Retention scans by age across ALL users; the composite indexes above are
  /// user-scoped and cannot serve a bare createdAt range.
  @@index([createdAt])
}

model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  failureCount  Int       @default(0)
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Badge {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  description   String
  icon          String
  requirements  Json
  rewardCredits Int         @default(0)
  rewardXp      Int         @default(0)
  createdAt     DateTime    @default(now())
  users         UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@index([userId, earnedAt])
}

model Activity {
  id        String       @id @default(cuid())
  userId    String
  actorId   String?
  type      ActivityType
  targetId  String?
  metadata  Json?
  createdAt DateTime     @default(now())
  user      User         @relation("userActivities", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?        @relation("actorActivities", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type, createdAt])
  /// Retention scans by age across all users.
  @@index([createdAt])
}

model Referral {
  id         String    @id @default(cuid())
  referrerId String
  referredId String    @unique
  code       String
  ipHash     String?
  /// Set once the bonus has actually been paid (on the referred user's first
  /// verified support, not at signup). Idempotency guard for the payout.
  creditedAt DateTime?
  createdAt  DateTime  @default(now())
  referrer   User      @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   User      @relation("referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([referrerId])
}

model Report {
  id             String           @id @default(cuid())
  reporterId     String
  targetType     ReportTargetType
  targetId       String
  reason         String
  description    String?
  status         ReportStatus     @default(OPEN)
  severity       Int              @default(1)
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  reporter       User             @relation("reportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy     User?            @relation("reportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String?
  entityId  String?
  /// Hashed, never the raw IP.
  ipHash    String?
  userAgent String?
  metadata  Json?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
